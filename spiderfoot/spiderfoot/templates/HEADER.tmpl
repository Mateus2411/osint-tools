<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8">
    <title>SpiderFoot v${version}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" type="image/png" href="${docroot}/static/img/spiderfoot-icon.png">

    <!-- Google Fonts: Sora + Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">

    <script type='text/javascript' src='${docroot}/static/js/spiderfoot.js'></script>
    <script type='text/javascript' src='${docroot}/static/js/viz.js'></script>

    <link href="${docroot}/static/node_modules/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${docroot}/static/node_modules/tablesorter/dist/css/jquery.tablesorter.pager.min.css" rel="stylesheet">
    <link href="${docroot}/static/node_modules/alertifyjs/build/css/alertify.min.css" rel="stylesheet">

    <!-- Main Design System (meely-inspired) -->
    <link href="${docroot}/static/css/spiderfoot.css?v=17" rel="stylesheet">
    <link href="${docroot}/static/css/dark.css?v=3" rel="stylesheet">
    <link href="${docroot}/static/css/light.css?v=1" rel="stylesheet">

    <script>
        // Restore theme preference before page renders
        (function() {
            var theme = localStorage.getItem('sf-theme');
            if (!theme) theme = 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
  </head>

  <body>

<!-- ═══════════════ TOP NAV (meely-style) ═══════════════ -->
<nav class="navbar navbar-fixed-top navbar-default">
  <div class="container-fluid">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-navbar-collapse" aria-expanded="false">
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand brand-logo dark" href="${docroot}/">
        <img class="spiderfoot-header-image" src="${docroot}/static/img/spiderfoot-header-dark.png" />
      </a>
      <a class="navbar-brand brand-logo light" href="${docroot}/">
        <img class="spiderfoot-header-image" src="${docroot}/static/img/spiderfoot-header.png" />
      </a>
    </div>

    <div class="collapse navbar-collapse" id="main-navbar-collapse">
      <ul class="nav navbar-nav">
        <li
% if pageid == "NEWSCAN":
    class="active"
% endif
class="nav-item"
><a id="nav-link-newscan" href="${docroot}/newscan">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:6px"><path d="M12 5v14M5 12h14"/></svg>
  New Scan</a></li>
        <li 
% if pageid == "SCANLIST": 
    class="active"
% endif
class="nav-item"
><a id="nav-link-scans" href="${docroot}/scans">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:6px"><path d="M3 17l6-6 4 4 8-8"/></svg>
  Scans</a></li>
        <li
% if pageid == "SETTINGS":
    class="active"
%endif
class="nav-item"><a id="nav-link-settings" href="${docroot}/opts">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:6px"><circle cx="12" cy="12" r="3"/><path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
  Settings</a></li>
      </ul>

      <ul class="nav navbar-nav navbar-right">
        <li>
          <span id="toggler-text">Dark Mode</span>
          <label id="switcher4" class="switch">
            <input id="theme-toggler" class="theme-toggler" type="checkbox">
            <span class="slider round"></span>
          </label>
        </li>
        <li class="nav-item"><a href="#aboutmodal" data-toggle="modal" data-target="#aboutmodal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:6px"><circle cx="12" cy="12" r="9"/><path d="M12 17v-6M12 7h.01"/></svg>
          Sobre</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- ═══════════════ ABOUT MODAL ═══════════════ -->
<div id="aboutmodal" class="modal fade" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">SpiderFoot ${version}</h3>
      </div>
      <div class="modal-body">
        <p><b>SpiderFoot</b> é uma ferramenta OSINT open-source criada por <a href='https://twitter.com/binarypool' target=_new>Steve Micallef</a> (licença MIT).</p>
        <p><b>Versão modificada por <a href='https://github.com/Mateus' target=_new>Mateus</a></b> &mdash; interface remodelada com design escuro, responsivo e melhorias visuais.</p>
        <p>Você está rodando a versão <b>${version}</b>.</p>
        <p>
          <a href='https://www.spiderfoot.net/' target=_new>Site oficial</a> &middot;
          <a href='https://github.com/smicallef/spiderfoot' target=_new>GitHub original</a> &middot;
          <a href='https://discord.gg/vyvztrG' target=_new>Discord</a>
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

