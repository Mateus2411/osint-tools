<%include file="HEADER.tmpl"/>
<script src="${docroot}/static/js/spiderfoot.newscan.js"></script>

<!-- Wrapper: brain behind everything -->
<div style="position:relative;min-height:500px;">

  <!-- Brain background (z-index: 0) -->
  <div style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;overflow:hidden;background:radial-gradient(ellipse at 50% 40%, rgba(51,224,216,0.06), transparent 60%);">
    <canvas id="brain-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;display:block;"></canvas>
  </div>

  <!-- Content on top (z-index: 1) -->
  <div style="position:relative;z-index:1;">
    <!-- Overlay text - top right, same level as inputs -->
    <div style="position:absolute;top:0;right:0;text-align:right;pointer-events:none;z-index:2;padding:20px 24px;">
      <div style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);letter-spacing:0.08em;margin-bottom:2px;">SPIDERFOOT OSINT ENGINE</div>
      <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--accent);text-shadow:0 0 30px var(--accent-glow);">Ready to scan</div>
    </div>
    <div class="page-head" style="margin-bottom:0;">
      <h1>New Scan</h1>
    </div>

    <form class="form" action='${docroot}/startscan' method='POST'>

<!-- Flex row: inputs + button on same line -->
<div class="newscan-top-row">

  <!-- Inputs -->
  <div class="newscan-inputs">
    <div>
      <label for="scanname">Scan Name</label>
      <input class='form-control' type="text" id="scanname" name="scanname" value="${scanname}" placeholder="The name of this scan." style="margin-bottom:12px;">

      <label for="scantarget">Scan Target</label>
      <input class='form-control' type="text" value="${scantarget}" id="scantarget" name="scantarget" placeholder="The target of your scan." style="margin-bottom:4px;">

      <div style="margin-top:10px;padding:12px;border:1px solid var(--border-soft);border-radius:var(--radius-md);background:var(--bg-panel-2);font-size:12px;color:var(--text-secondary);line-height:1.7;">
        <strong style="color:var(--accent);font-size:13px;">Supported target types</strong><br>
        <b>Domain Name</b>: example.com<br>
        <b>IPv4</b>: 1.2.3.4<br>
        <b>IPv6</b>: 2606:4700:4700::1111<br>
        <b>Hostname</b>: abc.example.com<br>
        <b>Subnet</b>: 1.2.3.0/24<br>
        <b>Bitcoin</b>: 1HesYJSP1QqcyPEjnQ9vzBL1wujruNGe7R<br>
        <b>E-mail</b>: bob@example.com<br>
        <b>Phone</b>: +12345678901 (E.164)<br>
        <b>Human Name</b>: "John Smith"<br>
        <b>Username</b>: "jsmith2000"<br>
        <b>ASN</b>: 1234
      </div>
    </div>
  </div>

  <!-- Button -->
  <div class="run-scan-row">
    <input type=hidden id='modulelist' name='modulelist' value=''>
    <input type=hidden id='typelist' name='typelist' value=''>
    <button id="btn-run-scan" class="btn-run-scan">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      Run Scan Now
    </button>
  </div>

</div><!-- /newscan-top-row -->

<div class="control-group">
  <div class="tab-bar">
    <ul class='nav nav-tabs'>
      <li id='usetab' class="active"><a href='#'>By Use Case</a></li>
      <li id='typetab'><a href='#'>By Required Data</a></li>
      <li id='moduletab'><a href='#'>By Module</a></li>
    </ul>
    <div class="tab-selectors" role="group" id='selectors' style='display: none;'>
      <button id="btn-select-all" type="button" class="btn btn-info btn-sm">Select All</button>
      <button id="btn-deselect-all" type="button" class="btn btn-info btn-sm">De-Select All</button>
    </div>
  </div>

  <div class="table-wrap">
  <table class="table table-striped table-condensed" id="usetable">
    <tr><td style='width:50px'><input type=radio name='usecase' value='all' id="usecase_all" checked></td><td><strong>All</strong></td><td>Get anything and everything about the target. All SpiderFoot modules will be enabled (slow) but every possible piece of information will be obtained and analysed.</td></tr>
    <tr><td><input type=radio name='usecase' value='Footprint' id="usecase_footprint"></td><td><strong>Footprint</strong></td><td>Understand what information this target exposes to the Internet. Gain an understanding about the target's network perimeter, associated identities and other information obtained through web crawling and search engine use.</td></tr>
    <tr><td><input type=radio name='usecase' value='Investigate' id="usecase_investigate"></td><td><strong>Investigate</strong></td><td>Best for when you suspect the target to be malicious but need more information. Some basic footprinting will be performed in addition to querying of blacklists and other sources.</td></tr>
    <tr><td><input type=radio name='usecase' value='Passive' id="usecase_passive"></td><td><strong>Passive</strong></td><td>When you don't want the target to even suspect they are being investigated. Only modules that do not touch the target will be enabled.</td></tr>
  </table>

        <table class="table table-striped table-condensed" id="moduletable" style="display: none">
            <%
            modlist = dict()
            for item in modules:
                modlist[modules[item]['name']] = item
            %>
            % for it in sorted(modlist, key=lambda v: v.upper()):
                <% item = modlist[it] %>
                <% keylist = dict((k, v) for k, v in modules[item]['opts'].items() if not k.startswith('_')) %>
                <% keyicon = "" %>
                % if len(keylist) > 0:
                    <% apikeylist = dict((k, v) for k, v in modules[item]['opts'].items() if k.find("api_key") >= 0) %>
                    <%
                    if len(apikeylist) > 0:
                        keyicon = "&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\" rel='tooltip' title='Needs API key'></i>"
                    %>
                % endif

                % if item != "sfp__stor_db" and item != "sfp__stor_stdout":
                    <tr><td style="width:50px"><input type=checkbox id="module_${item}" checked></td><td>${modules[item]['name']}${keyicon}</td><td>${modules[item]['descr']}</td></tr>
                % endif
            % endfor
        </table>
        <table class="table table-striped table-condensed" id="typetable" style="display: none">
            <% count = 0 %>
            % for item in sorted(types):
                % if count % 2 == 0:
                    <tr>
                % endif
                <td style="width:50px"><input type=checkbox id="type_${item[1]}" checked></td><td>${item[0]}</td>
                % if not count % 2 == 0:
                    </tr>
                % endif
                <% count = count + 1 %>
            % endfor
        </table>
  </div>

</div>
</form>
  </div>
</div><!-- /wrapper -->

<script>
/* particle sphere: brain of points (responsive) */
(function(){
  var canvas = document.getElementById('brain-canvas');
  if(!canvas) return;
  var parent = canvas.parentElement;
  var ctx = canvas.getContext('2d');
  var ACCENT = '#33e0d8';
  var N = 360;
  var pts = [];
  var t = 0;

  function resize(){
    var rect = parent.getBoundingClientRect();
    canvas.width = Math.round(rect.width * window.devicePixelRatio);
    canvas.height = Math.round(rect.height * window.devicePixelRatio);
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }
  resize();

  for(var i=0;i<N;i++){
    var theta = Math.acos(2*Math.random()-1);
    var phi = Math.random()*Math.PI*2;
    var r = 145 + Math.random()*55;
    var x = r*Math.sin(theta)*Math.cos(phi);
    var y = r*Math.sin(theta)*Math.sin(phi)*0.9;
    var z = r*Math.cos(theta);
    pts.push({x:x,y:y,z:z, phase:Math.random()*Math.PI*2, speed:0.008+Math.random()*0.015, size:0.7+Math.random()*2.0});
  }

  function draw(){
    t += 0.004;
    var W = canvas.width / window.devicePixelRatio;
    var H = canvas.height / window.devicePixelRatio;
    var cx = W/2, cy = H/2;
    ctx.clearRect(0,0,canvas.width,canvas.height);

    var grad = ctx.createRadialGradient(cx,cy,0,cx,cy,Math.min(W,H)*0.42);
    grad.addColorStop(0,'rgba(51,224,216,0.12)');
    grad.addColorStop(1,'rgba(51,224,216,0)');
    ctx.fillStyle = grad;
    ctx.beginPath(); ctx.arc(cx,cy,Math.min(W,H)*0.42,0,Math.PI*2); ctx.fill();

    var maxR = Math.min(W,H) * 0.48;
    var sorted = pts.map(function(p){
      var rot = t*0.6;
      var x2 = p.x*Math.cos(rot) - p.z*Math.sin(rot);
      var z2 = p.x*Math.sin(rot) + p.z*Math.cos(rot);
      var scale = 300/(300+z2);
      var ratio = maxR / 150;
      return {px: cx + x2*scale*ratio, py: cy + p.y*scale*ratio, z:z2, size:p.size, scale:scale, phase:p.phase};
    }).sort(function(a,b){return a.z-b.z;});

    for(var j=0;j<sorted.length;j++){
      var p = sorted[j];
      var tw = 0.5 + 0.5*Math.sin(p.phase + t*6);
      var alpha = 0.3 + 0.7 * Math.min(1, (p.z+200)/400);

      ctx.strokeStyle = 'rgba(51,224,216,' + (0.04*alpha) + ')';
      ctx.lineWidth = 0.4;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(p.px, p.py);
      ctx.stroke();

      var sz = p.size * p.scale * (0.6 + 0.4*tw);
      ctx.fillStyle = 'rgba(255,255,255,' + (0.5*alpha*tw) + ')';
      ctx.shadowColor = ACCENT;
      ctx.shadowBlur = sz * 6;
      ctx.beginPath();
      ctx.arc(p.px, p.py, Math.max(0.3, sz), 0, Math.PI*2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }
    requestAnimationFrame(draw);
  }
  draw();

  window.addEventListener('resize', resize);
})();
</script>

<script type='text/javascript'>
  if ("${selectedmods}" != "") {
          switchTab("module");

          $("input[id^=module_]").each(function(id, obj) {
              if ("${selectedmods}".indexOf(obj.id.replace("module_", "")) >= 0) {
                  $("#" + obj.id).attr("checked", true);
              } else {
                  $("#" + obj.id).attr("checked", false);
              }
          });
  }
</script>
<%include file="FOOTER.tmpl"/>
